---
import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  description: string;
  tags: string[];
  image?: string; // path under public/, e.g. /work/foo.png
  github?: string;
  demo?: string;
}
const { title, description, tags, image, github, demo } = Astro.props;
---

<article class="project card">
  <div class="project-media">
    {image ? (
      <img src={image} alt={`${title} preview`} loading="lazy" decoding="async" />
    ) : (
      <div class="media-fallback" aria-hidden="true"><Icon name="lucide:folder-git-2" /></div>
    )}
    <div class="project-links">
      {github && (
        <a href={github} target="_blank" rel="noopener noreferrer" aria-label={`${title} on GitHub`}>
          <Icon name="simple-icons:github" /> Code
        </a>
      )}
      {demo && demo !== '#' && (
        <a href={demo} target="_blank" rel="noopener noreferrer" aria-label={`${title} live demo`}>
          <Icon name="lucide:external-link" /> Demo
        </a>
      )}
    </div>
  </div>
  <div class="project-body">
    <h3>{title}</h3>
    <p>{description}</p>
    <ul class="project-tags">
      {tags.map((t) => <li class="chip">{t}</li>)}
    </ul>
  </div>
</article>

<style>
  .project { overflow: hidden; display: flex; flex-direction: column; transition: transform 0.25s var(--ease), border-color 0.25s var(--ease); }
  .project:hover { transform: translateY(-4px); border-color: var(--accent-line); }
  .project-media { position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-bottom: 1px solid var(--border); background: var(--bg-elev); }
  .project-media img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s var(--ease); }
  .project:hover .project-media img { transform: scale(1.04); }
  .media-fallback { display: grid; place-items: center; height: 100%; background: radial-gradient(circle at 50% 40%, var(--accent-glow), transparent 70%); }
  .media-fallback [data-icon] { width: 42px; height: 42px; color: var(--accent); opacity: 0.55; }
  .project-links {
    position: absolute; inset: 0; display: flex; align-items: flex-end; gap: 0.6rem;
    padding: 0.9rem; opacity: 0; background: linear-gradient(0deg, rgba(3,6,5,0.92), transparent 65%);
    transition: opacity 0.25s var(--ease);
  }
  .project:hover .project-links, .project:focus-within .project-links { opacity: 1; }
  .project-links a {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-family: var(--font-mono); font-size: 0.8rem;
    padding: 0.45rem 0.75rem; border-radius: var(--radius);
    background: var(--panel); border: 1px solid var(--border); color: var(--text);
  }
  .project-links a:hover { border-color: var(--accent-line); color: var(--accent); }
  .project-links [data-icon] { width: 15px; height: 15px; }
  .project-body { padding: 1.25rem; display: flex; flex-direction: column; flex: 1; }
  .project-body h3 { font-size: 1.15rem; }
  .project-body p { color: var(--text-dim); font-size: 0.9rem; margin-top: 0.5rem; flex: 1; }
  .project-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 1rem; list-style: none; padding: 0; }
</style>

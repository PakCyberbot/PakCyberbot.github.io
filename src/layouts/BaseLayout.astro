---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site, socials } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  article?: { publishedTime?: string; tags?: string[] };
}

const {
  title,
  description = site.description,
  image = '/og-default.png',
  type = 'website',
  article,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(image, site.url).href;

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: 'PakCyberbot',
  url: site.url,
  email: `mailto:${site.email}`,
  jobTitle: 'Security Researcher',
  description: site.description,
  sameAs: socials.map((s) => s.href),
};
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="theme-color" content="#050607" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {article?.publishedTime && (
      <meta property="article:published_time" content={article.publishedTime} />
    )}
    {article?.tags?.map((t) => <meta property="article:tag" content={t} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:creator" content="@pakcyberbot" />

    <link rel="alternate" type="application/rss+xml" title={`${site.name} — Blog`} href="/rss.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!-- Scroll reveal: progressive enhancement, respects reduced-motion. -->
    <script>
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');

      const reveal = (el: HTMLElement, animate: boolean) => {
        if (animate) {
          const delay = el.dataset.revealDelay;
          if (delay) el.style.transitionDelay = `${delay}ms`;
        }
        el.classList.add('is-visible');
      };

      const revealAll = () => els.forEach((el) => reveal(el, false));

      if (prefersReduced || !('IntersectionObserver' in window)) {
        revealAll();
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              // Reveal on scroll-in (animated), OR immediately if the element is
              // already above the viewport — e.g. a back/forward that restored
              // scroll mid-page without bfcache, where those cards will never
              // intersect and would otherwise stay invisible.
              const scrolledPast = entry.boundingClientRect.top < 0;
              if (entry.isIntersecting || scrolledPast) {
                reveal(entry.target as HTMLElement, entry.isIntersecting);
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        els.forEach((el) => io.observe(el));
      }

      // bfcache restore (Back/Forward): the module script does NOT re-run, but this
      // listener survives in the cached page and still fires. The entrance animation
      // already played on the first visit, so just reveal everything instantly —
      // this is what prevents the "only some articles show until refresh" glitch.
      window.addEventListener('pageshow', (e) => {
        if (e.persisted) revealAll();
      });
    </script>
  </body>
</html>

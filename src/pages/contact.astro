---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, socials, platforms } from '../data/site';
const links = [...socials, ...platforms];
---

<BaseLayout title="Contact" description="Get in touch with Faraz Ahmed (PakCyberbot) for security research, collaboration or opportunities.">
  <section class="section">
    <div class="container contact-wrap">
      <div class="contact-main card">
        <span class="eyebrow">./contact --open</span>
        <h1 class="section-title">Let's talk</h1>
        <p class="section-lead">Open to security research collaboration, CTF teams, challenge authoring and full-time opportunities. Email is the fastest way to reach me.</p>

        <a class="email-line" href={`mailto:${site.email}`}>
          <Icon name="lucide:mail" />
          <span class="mono">{site.email}</span>
        </a>

        <div class="contact-actions">
          <a class="btn btn-primary" href={`mailto:${site.email}`}>
            <Icon name="lucide:mail" /> Send an email
          </a>
        </div>
      </div>

      <div class="contact-links">
        <h2 class="links-title mono">// elsewhere</h2>
        <div class="links-grid">
          {links.map((l) => (
            <a class="clink card" href={l.href} target="_blank" rel="noopener noreferrer">
              <Icon name={l.icon} />
              <span>
                <b>{l.label}</b>
                <span class="mono chandle">{l.handle}</span>
              </span>
              <Icon name="lucide:arrow-up-right" class="go" />
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; align-items: start; }
  .contact-main { padding: 2rem; }
  .email-line {
    display: inline-flex; align-items: center; gap: 0.6rem;
    margin-top: 1.5rem; padding: 0.8rem 1rem;
    border: 1px dashed var(--accent-line); border-radius: 10px;
    background: var(--accent-glow); color: var(--accent);
  }
  .email-line [data-icon] { width: 18px; height: 18px; }
  .contact-actions { display: flex; gap: 0.7rem; margin-top: 1.5rem; flex-wrap: wrap; }
  .contact-actions [data-icon] { width: 17px; height: 17px; }

  .links-title { color: var(--text-mute); font-size: 0.9rem; margin-bottom: 0.9rem; }
  .links-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.7rem; }
  .clink { display: flex; align-items: center; gap: 0.7rem; padding: 0.85rem 1rem; color: var(--text); transition: transform 0.2s var(--ease), border-color 0.2s var(--ease); }
  .clink:hover { transform: translateY(-2px); border-color: var(--accent-line); color: var(--text); }
  .clink > [data-icon]:first-child { width: 22px; height: 22px; color: var(--accent); flex-shrink: 0; }
  .clink span { display: flex; flex-direction: column; min-width: 0; }
  .clink b { font-size: 0.9rem; }
  .chandle { font-size: 0.72rem; color: var(--text-mute); overflow: hidden; text-overflow: ellipsis; }
  .clink .go { width: 16px; height: 16px; color: var(--text-mute); margin-left: auto; flex-shrink: 0; }

  @media (max-width: 820px) {
    .contact-wrap { grid-template-columns: 1fr; }
  }
  @media (max-width: 420px) {
    .links-grid { grid-template-columns: 1fr; }
  }
</style>
